# Posture Check! - Environment Configuration Template
# Duplicate this file to .env.local for local development, or configure in CI/hosting platforms.

# ==============================================================================
# Supabase Backend Configuration
# ==============================================================================
# Local: http://localhost:54321
# Cloud: https://<project-ref>.supabase.co
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0NDEyMDB9.CRX_default_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# Local Supabase Ports:
# API: 54321 | DB: 54322 | Studio: 54323 | Inbucket: 54324

# ==============================================================================
# Desktop App (Vite / Tauri Frontend)
# ==============================================================================
# In Vite, client-accessible variables must start with VITE_
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0NDEyMDB9.CRX_default_local_anon_key

# ==============================================================================
# Mobile App (Expo / React Native)
# ==============================================================================
# In Expo, client-accessible variables must start with EXPO_PUBLIC_
# NOTE for mobile testing against local Supabase:
# - Android Emulator: use http://10.0.2.2:54321
# - Physical device: use your machine's LAN IP, e.g., http://192.168.x.x:54321
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0NDEyMDB9.CRX_default_local_anon_key

# ==============================================================================
# OAuth Credentials (Optional / Phase 4)
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# ==============================================================================
# Sentry Crash Reporting (Optional)
# ==============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
