{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Posture Check!",
  "version": "0.1.0",
  "identifier": "com.posturecheck.app",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Posture Check!",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "visible": false
      },
      {
        "label": "notification-overlay",
        "title": "Posture Check! Alert",
        "url": "overlay.html",
        "width": 500,
        "height": 300,
        "minWidth": 500,
        "minHeight": 300,
        "maxWidth": 500,
        "maxHeight": 300,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "notification-fullscreen",
        "title": "Posture Check! Wake Up",
        "url": "fullscreen.html",
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "tooltip": "Posture Check!"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' ipc:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "sql": {
      "preload": []
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGMjNFMDQ2NzcwQjc0MTgKUldTRjZ2MVRlUGZZZ2dYNHl1WkcyMUtZVWt2M1N2bWZhMWlyOGZNYndjQmlqVzRGNXRhK2FzUWYK",
      "endpoints": ["https://github.com/posture-check/releases/latest/download/latest.json"]
    }
  }
}
